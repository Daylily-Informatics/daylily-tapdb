{
  "$comment": "TapDB reserved canonical template for federated TapDB object references",
  "templates": [
    {
      "name": "TapDB Object Reference",
      "polymorphic_discriminator": "generic_template",
      "category": "reference",
      "type": "external_identifier",
      "subtype": "tapdb_object",
      "version": "1.0",
      "instance_prefix": "XRF",
      "is_singleton": false,
      "bstatus": "active",
      "json_addl": {
        "description": "Canonical graph-expandable reference to an object persisted by another exact TapDB service.",
        "properties": {
          "target_service_id": null,
          "target_object_euid": null,
          "target_tenant_id": null,
          "target_object_kind": null
        },
        "instantiation_layouts": []
      },
      "json_addl_schema": {
        "type": "object",
        "required": ["properties", "action_groups", "audit_log", "identity_claim"],
        "properties": {
          "properties": {
            "type": "object",
            "required": ["target_service_id", "target_object_euid", "target_tenant_id", "target_object_kind"],
            "properties": {
              "target_service_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "target_object_euid": {"type": "string", "minLength": 1, "maxLength": 255},
              "target_tenant_id": {"type": ["string", "null"], "format": "uuid"},
              "target_object_kind": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
            },
            "additionalProperties": false
          },
          "action_groups": {"type": "object", "maxProperties": 0},
          "audit_log": {"type": "array", "maxItems": 0},
          "identity_claim": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  ]
}
